
# Application
NODE_ENV=development
PORT=5000
API_VERSION=1.0.0

# Database
MONGO_URI=

# Authentication secrets: generate unique random values of at least 32 characters
JWT_SECRET=
SESSION_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional if Google sign-in is not configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Email configuration
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# SMTP configuration, if applicable
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=